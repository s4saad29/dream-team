# Base URL for Addo Dream Team
BASE_URL=https://team.addo.ai

# Optional credentials for authenticated tests (leave empty for UI-only tests)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Run headless (true/false)
HEADLESS=false

# Default timeout in milliseconds
DEFAULT_TIMEOUT=30000
